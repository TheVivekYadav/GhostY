<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/createQrBackButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹   Back"
            android:textColor="#B8ACFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your pairing QR"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Let the other person scan this code to request a connection."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:padding="16dp">

            <ImageView
                android:id="@+id/pairingQrImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="One-time pairing QR code"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery" />

        </FrameLayout>

        <TextView
            android:id="@+id/pairingQrStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Preparing invitation..."
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairingQrCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Invitation expires in 02:00"
            android:textColor="#F59E0B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/cancelQrButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Cancel invitation"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
