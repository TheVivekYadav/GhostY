<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#0B1120"
    android:padding="24dp">

    <TextView
        android:id="@+id/pairingApprovalBackButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="‹   Back"
        android:textColor="#B8ACFF"
        android:textSize="16sp" />

    <View
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="44dp"
        android:background="#29234F" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Pairing request"
        android:textColor="#F8FAFC"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Another device wants to establish a private conversation with you."
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#172033">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INVITATION"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairingRequestDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="One-time invitation"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pairingRequestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Waiting for your decision"
            android:textColor="#F59E0B"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Only accept if you intended to connect. This invitation alone does not verify the other person's identity."
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/acceptPairingButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Accept and connect"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/rejectPairingButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:text="Reject request"
        android:textAllCaps="false" />

</LinearLayout>
